@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = $"Customer: {Model.CustomerName}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0">@Model.CustomerName</h2>
            <span class="badge bg-light text-dark font-monospace border">@Model.CustomerCode</span>
            <span class="badge @(Model.Status == "Active" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") border">@Model.Status</span>
        </div>
        <p class="text-muted small mb-0">Customer Profile & Related History</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-success btn-sm">
            <i class="bi bi-graph-up me-1"></i> + New Deal
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-primary btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> + Follow-Up
        </a>
        <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-secondary btn-sm">
            <i class="bi bi-plus-circle me-1"></i> + Activity
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Master Details -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent fw-semibold">
                <i class="bi bi-info-circle me-1 text-primary"></i> Contact & Company Info
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="text-muted small">Company</div>
                    <div class="fw-semibold">@(Model.CompanyName ?? "N/A")</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small">Email Address</div>
                    <div><a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a></div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small">Phone Number</div>
                    <div class="fw-semibold">@Model.Phone</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small">Address</div>
                    <div>@(string.IsNullOrWhiteSpace(Model.Address) ? "N/A" : $"{Model.Address}, {Model.City}, {Model.State}")</div>
                </div>
                <hr />
                <div class="mb-2">
                    <div class="text-muted small">Account Owner</div>
                    <div class="fw-semibold">@(Model.Owner?.FullName ?? Model.Owner?.UserName ?? "Unassigned")</div>
                </div>
                <div class="mb-2">
                    <div class="text-muted small">Created Date</div>
                    <div class="small">@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm UTC")</div>
                </div>
                @if (Model.ModifiedDate.HasValue)
                {
                    <div class="mb-2">
                        <div class="text-muted small">Last Modified</div>
                        <div class="small">@Model.ModifiedDate.Value.ToString("yyyy-MM-dd HH:mm UTC")</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Related CRM Data (Deals, Follow-ups, Activities) -->
    <div class="col-lg-8">
        <!-- Related Opportunities -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <span class="fw-semibold"><i class="bi bi-graph-up-arrow me-1 text-success"></i> Opportunities (@Model.Opportunities.Count)</span>
                <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-success btn-sm py-0">+ Deal</a>
            </div>
            <div class="card-body p-0">
                @if (Model.Opportunities.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Deal Name</th>
                                    <th>Stage</th>
                                    <th>Amount</th>
                                    <th>Probability</th>
                                    <th>Close Date</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var opp in Model.Opportunities)
                                {
                                    <tr>
                                        <td class="fw-semibold">@opp.OpportunityName</td>
                                        <td><span class="badge bg-primary-subtle text-primary">@opp.Stage</span></td>
                                        <td class="fw-bold text-success">$@opp.Amount.ToString("N0")</td>
                                        <td>@opp.Probability%</td>
                                        <td class="small">@opp.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opp.OpportunityId" class="btn btn-sm btn-link p-0">View</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-3 text-center text-muted small">No active opportunities.</div>
                }
            </div>
        </div>

        <!-- Related Follow-Ups -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <span class="fw-semibold"><i class="bi bi-calendar-event me-1 text-primary"></i> Follow-Ups (@Model.FollowUps.Count)</span>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-primary btn-sm py-0">+ Follow-Up</a>
            </div>
            <div class="card-body p-0">
                @if (Model.FollowUps.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Subject</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in Model.FollowUps)
                                {
                                    <tr>
                                        <td class="small @(f.IsOverdue ? "text-danger fw-bold" : "")">@f.FollowUpDate.ToString("yyyy-MM-dd")</td>
                                        <td class="fw-semibold">@f.Subject</td>
                                        <td><span class="badge bg-secondary-subtle text-secondary">@f.FollowUpType</span></td>
                                        <td>
                                            <span class="badge @(f.Status == "Completed" ? "bg-success" : (f.IsOverdue ? "bg-danger" : "bg-warning"))">@f.Status</span>
                                        </td>
                                        <td>
                                            <a asp-controller="FollowUps" asp-action="Details" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-link p-0">View</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-3 text-center text-muted small">No scheduled follow-ups.</div>
                }
            </div>
        </div>

        <!-- Related Activities History -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <span class="fw-semibold"><i class="bi bi-clock-history me-1 text-secondary"></i> Activity Timeline (@Model.Activities.Count)</span>
                <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-secondary btn-sm py-0">+ Activity</a>
            </div>
            <div class="card-body p-0">
                @if (Model.Activities.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var act in Model.Activities.OrderByDescending(a => a.ActivityDate))
                        {
                            <li class="list-group-item py-3">
                                <div class="d-flex justify-content-between">
                                    <span class="fw-semibold text-dark"><i class="bi bi-check-circle text-success me-1"></i> @act.Subject</span>
                                    <small class="text-muted">@act.ActivityDate.ToString("yyyy-MM-dd HH:mm")</small>
                                </div>
                                <div class="small text-muted mt-1">@act.Description</div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="p-3 text-center text-muted small">No logged activities.</div>
                }
            </div>
        </div>
    </div>
</div>
