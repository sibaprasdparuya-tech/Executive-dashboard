@model IEnumerable<AcxiomCRM.Models.Customer>
@{
    ViewData["Title"] = "Customer Management";
    var currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var totalCount = (int)(ViewData["TotalCount"] ?? 0);
    var searchTerm = ViewData["SearchTerm"]?.ToString();
    var statusFilter = ViewData["Status"]?.ToString();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-0">Customer Master</h2>
        <p class="text-muted small mb-0">Manage accounts, contacts, and relationship records</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Add New Customer
        </a>
    </div>
</div>

<!-- Search and Filters (Section 17.13) -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@searchTerm" class="form-control" placeholder="Search by name, email, phone, or company..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(statusFilter == "Active")">Active</option>
                    <option value="Inactive" selected="@(statusFilter == "Inactive")">Inactive</option>
                    <option value="Prospect" selected="@(statusFilter == "Prospect")">Prospect</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Customer Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Showing @Model.Count() of @totalCount Customers</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Customer Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Company</th>
                            <th>Status</th>
                            <th>Owner</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark font-monospace border">@c.CustomerCode</span>
                                </td>
                                <td class="fw-semibold">
                                    <a asp-action="Details" asp-route-id="@c.CustomerId" class="text-decoration-none text-dark">
                                        @c.CustomerName
                                    </a>
                                </td>
                                <td>
                                    <a href="mailto:@c.Email" class="text-decoration-none text-muted small">
                                        <i class="bi bi-envelope me-1"></i>@c.Email
                                    </a>
                                </td>
                                <td>
                                    <span class="small text-muted"><i class="bi bi-telephone me-1"></i>@c.Phone</span>
                                </td>
                                <td>@(c.CompanyName ?? "-")</td>
                                <td>
                                    @if (c.Status == "Active")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                    }
                                    else if (c.Status == "Inactive")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inactive</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">@c.Status</span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @(c.Owner?.FullName ?? c.Owner?.UserName ?? "Unassigned")
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@c.CustomerId" class="btn btn-outline-secondary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@c.CustomerId" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Delete Confirmation Modal (Section 12 UX Standards) -->
                                    <div class="modal fade text-start" id="deleteModal-@c.CustomerId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Deletion</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Are you sure you want to delete customer <strong>@c.CustomerName</strong> (@c.CustomerCode)?
                                                    <p class="text-muted small mt-2">This action is audited and cannot be undone.</p>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@c.CustomerId" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm">Yes, Delete Customer</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                    <span class="small text-muted">Page @currentPage of @totalPages</span>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchTerm="@searchTerm" asp-route-status="@statusFilter">Previous</a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchTerm="@searchTerm" asp-route-status="@statusFilter">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchTerm="@searchTerm" asp-route-status="@statusFilter">Next</a>
                        </li>
                    </ul>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-building-exclamation fs-1 text-muted"></i>
                <h5 class="mt-3 text-muted">No customers found</h5>
                <p class="text-muted small">Try adjusting your search criteria or add a new customer.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm">Create Customer</a>
            </div>
        }
    </div>
</div>
