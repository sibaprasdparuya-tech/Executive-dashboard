@model AcxiomCRM.Models.FollowUp
@{
    ViewData["Title"] = $"Follow-Up: {Model.Subject}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0">@Model.Subject</h2>
            <span class="badge @(Model.Status == "Completed" ? "bg-success" : (Model.IsOverdue ? "bg-danger" : "bg-warning"))">@Model.Status</span>
            <span class="badge bg-secondary-subtle text-secondary">@Model.FollowUpType</span>
        </div>
        <p class="text-muted small mb-0">Follow-Up Task Record</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.FollowUpId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent fw-semibold">
                <i class="bi bi-calendar3 me-1 text-primary"></i> Follow-Up Particulars
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="text-muted small">Target Date</div>
                    <h5 class="fw-bold @(Model.IsOverdue ? "text-danger" : "text-dark") mb-0">
                        @Model.FollowUpDate.ToString("MMMM dd, yyyy")
                        @if (Model.IsOverdue)
                        {
                            <span class="badge bg-danger ms-2">OVERDUE</span>
                        }
                    </h5>
                </div>
                <div class="mb-3">
                    <div class="text-muted small">Assigned User</div>
                    <div class="fw-semibold">@(Model.AssignedUser?.FullName ?? Model.AssignedUser?.UserName ?? "Unassigned")</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small">Status</div>
                    <div><span class="badge @(Model.Status == "Completed" ? "bg-success" : "bg-warning")">@Model.Status</span></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                {
                    <div class="mb-3">
                        <div class="text-muted small">Remarks & Agenda</div>
                        <div class="p-2 bg-light rounded small">@Model.Remarks</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent fw-semibold">
                <i class="bi bi-link-45deg me-1 text-secondary"></i> Associated Relationship
            </div>
            <div class="card-body">
                @if (Model.Customer != null)
                {
                    <div class="mb-3">
                        <div class="text-muted small">Customer Account</div>
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="fw-semibold text-decoration-none">
                            <i class="bi bi-building me-1"></i>@Model.Customer.CustomerName
                        </a>
                    </div>
                }
                @if (Model.Lead != null)
                {
                    <div class="mb-3">
                        <div class="text-muted small">Prospective Lead</div>
                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId" class="fw-semibold text-decoration-none">
                            <i class="bi bi-person me-1"></i>@Model.Lead.LeadName
                        </a>
                    </div>
                }
                @if (Model.Opportunity != null)
                {
                    <div class="mb-3">
                        <div class="text-muted small">Sales Opportunity</div>
                        <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@Model.OpportunityId" class="fw-semibold text-decoration-none">
                            <i class="bi bi-graph-up me-1"></i>@Model.Opportunity.OpportunityName
                        </a>
                    </div>
                }
                @if (Model.Customer == null && Model.Lead == null && Model.Opportunity == null)
                {
                    <p class="text-muted small">No specific CRM record attached to this follow-up.</p>
                }
            </div>
        </div>
    </div>
</div>
