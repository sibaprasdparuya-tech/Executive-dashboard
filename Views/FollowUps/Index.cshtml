@model IEnumerable<AcxiomCRM.Models.FollowUp>
@{
    ViewData["Title"] = "Follow-Up Management";
    var currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var totalCount = (int)(ViewData["TotalCount"] ?? 0);
    var pendingCount = (int)(ViewData["PendingCount"] ?? 0);
    var overdueCount = (int)(ViewData["OverdueCount"] ?? 0);
    var searchTerm = ViewData["SearchTerm"]?.ToString();
    var statusFilter = ViewData["Status"]?.ToString();
    var dateFilter = ViewData["Date"]?.ToString();
    var overdueOnly = ViewData["OverdueOnly"] as bool?;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-0">Follow-Up Tasks & Activities</h2>
        <p class="text-muted small mb-0">Scheduled touchpoints, client calls, meetings, and reviews</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
    </div>
</div>

<!-- Follow-Up Summary Badges (Section 4.6) -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <a asp-action="Index" class="card text-decoration-none border-0 shadow-sm p-3 border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Total Follow-Ups</div>
                    <h3 class="fw-bold mb-0 text-dark">@totalCount</h3>
                </div>
                <div class="p-2 rounded bg-primary-subtle text-primary"><i class="bi bi-calendar3 fs-4"></i></div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a asp-action="Index" asp-route-status="Planned" class="card text-decoration-none border-0 shadow-sm p-3 border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Pending / Planned</div>
                    <h3 class="fw-bold mb-0 text-warning">@pendingCount</h3>
                </div>
                <div class="p-2 rounded bg-warning-subtle text-warning"><i class="bi bi-clock-history fs-4"></i></div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a asp-action="Index" asp-route-overdueOnly="true" class="card text-decoration-none border-0 shadow-sm p-3 border-start border-danger border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Overdue Tasks</div>
                    <h3 class="fw-bold mb-0 text-danger">@overdueCount</h3>
                </div>
                <div class="p-2 rounded bg-danger-subtle text-danger"><i class="bi bi-exclamation-triangle-fill fs-4"></i></div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a asp-action="Index" asp-route-status="Completed" class="card text-decoration-none border-0 shadow-sm p-3 border-start border-success border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Completed</div>
                    <h3 class="fw-bold mb-0 text-success">@(totalCount - pendingCount)</h3>
                </div>
                <div class="p-2 rounded bg-success-subtle text-success"><i class="bi bi-check-circle-fill fs-4"></i></div>
            </div>
        </a>
    </div>
</div>

<!-- Search & Filters (Section 17.13) -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="searchTerm" value="@searchTerm" class="form-control" placeholder="Search subject or remarks..." />
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    @foreach (var st in AcxiomCRM.Models.FollowUpStatuses.All)
                    {
                        <option value="@st" selected="@(statusFilter == st)">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <input type="date" name="date" value="@dateFilter" class="form-control" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Follow-Ups List -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Showing @Model.Count() of @totalCount Follow-Ups</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Due Date</th>
                            <th>Subject</th>
                            <th>Type</th>
                            <th>Related To</th>
                            <th>Status</th>
                            <th>Assigned User</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model)
                        {
                            var isOverdue = f.IsOverdue;
                            <tr class="@(isOverdue ? "table-danger-subtle" : "")">
                                <td class="@(isOverdue ? "fw-bold text-danger" : "")">
                                    <i class="bi bi-calendar me-1"></i>@f.FollowUpDate.ToString("yyyy-MM-dd")
                                    @if (isOverdue)
                                    {
                                        <span class="badge bg-danger ms-1">OVERDUE</span>
                                    }
                                </td>
                                <td class="fw-semibold">
                                    <a asp-action="Details" asp-route-id="@f.FollowUpId" class="text-decoration-none text-dark">
                                        @f.Subject
                                    </a>
                                    @if (!string.IsNullOrWhiteSpace(f.Remarks))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width: 250px;">@f.Remarks</div>
                                    }
                                </td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@f.FollowUpType</span></td>
                                <td>
                                    @if (f.Customer != null)
                                    {
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@f.CustomerId" class="small text-decoration-none">
                                            <i class="bi bi-building me-1"></i>@f.Customer.CustomerName
                                        </a>
                                    }
                                    else if (f.Lead != null)
                                    {
                                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@f.LeadId" class="small text-decoration-none">
                                            <i class="bi bi-person me-1"></i>@f.Lead.LeadName
                                        </a>
                                    }
                                    else if (f.Opportunity != null)
                                    {
                                        <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@f.OpportunityId" class="small text-decoration-none">
                                            <i class="bi bi-graph-up me-1"></i>@f.Opportunity.OpportunityName
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="small text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (f.Status == "Completed")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check me-1"></i>Completed</span>
                                    }
                                    else if (f.Status == "Cancelled")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">Cancelled</span>
                                    }
                                    else if (f.Status == "Missed")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Missed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Planned</span>
                                    }
                                </td>
                                <td class="small text-muted">@(f.AssignedUser?.FullName ?? "Unassigned")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (f.Status == "Planned")
                                        {
                                            <!-- Mark Complete Button & Modal trigger -->
                                            <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#completeModal-@f.FollowUpId" title="Mark Complete">
                                                <i class="bi bi-check2"></i>
                                            </button>
                                            <!-- Reschedule Button & Modal trigger -->
                                            <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#rescheduleModal-@f.FollowUpId" title="Reschedule">
                                                <i class="bi bi-calendar-event"></i>
                                            </button>
                                        }
                                        <a asp-action="Edit" asp-route-id="@f.FollowUpId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteFollowModal-@f.FollowUpId" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Complete Modal (Section 4.6 & 8) -->
                                    <div class="modal fade text-start" id="completeModal-@f.FollowUpId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <form asp-action="Complete" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@f.FollowUpId" />
                                                    <div class="modal-header">
                                                        <h5 class="modal-title fw-bold text-success"><i class="bi bi-check-circle-fill me-2"></i>Complete Follow-Up</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p>Mark <strong>@f.Subject</strong> as Completed.</p>
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-semibold">Outcome / Completion Remarks</label>
                                                            <textarea name="remarks" class="form-control" rows="3" placeholder="Summary of meeting or call outcome..."></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-success btn-sm">Confirm Completion</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Reschedule Modal (Section 4.6 & 8) -->
                                    <div class="modal fade text-start" id="rescheduleModal-@f.FollowUpId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <form asp-action="Reschedule" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@f.FollowUpId" />
                                                    <div class="modal-header">
                                                        <h5 class="modal-title fw-bold text-warning"><i class="bi bi-calendar-event me-2"></i>Reschedule Follow-Up</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p>Reschedule <strong>@f.Subject</strong>.</p>
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-semibold">New Follow-Up Date <span class="text-danger">*</span></label>
                                                            <input type="date" name="newDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" value="@DateTime.Today.AddDays(3).ToString("yyyy-MM-dd")" required />
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-semibold">Reason for Rescheduling</label>
                                                            <input type="text" name="remarks" class="form-control" placeholder="e.g. Client requested postponement" />
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-warning btn-sm">Reschedule</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Delete Modal -->
                                    <div class="modal fade text-start" id="deleteFollowModal-@f.FollowUpId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold text-danger">Delete Follow-Up</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Delete follow-up <strong>@f.Subject</strong>?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                    <span class="small text-muted">Page @currentPage of @totalPages</span>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">Previous</a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Next</a>
                        </li>
                    </ul>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-check fs-1 text-muted"></i>
                <h5 class="mt-3 text-muted">No follow-ups found</h5>
                <a asp-action="Create" class="btn btn-primary btn-sm">Schedule Follow-Up</a>
            </div>
        }
    </div>
</div>
