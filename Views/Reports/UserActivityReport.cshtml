@model IEnumerable<AcxiomCRM.Services.UserActivitySummaryDto>
@{
    ViewData["Title"] = "User Activity Report";
    var fromDate = ViewData["FromDate"]?.ToString();
    var toDate = ViewData["ToDate"]?.ToString();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-0">User & Sales Activity Report</h2>
        <p class="text-muted small mb-0">Workload, operations volume, and activity log counts per team member</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="UserActivityReport" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-export="csv" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="bi bi-file-earmark-arrow-down me-1"></i> Export to CSV
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Hub
        </a>
    </div>
</div>

<!-- Date Filter -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="UserActivityReport" class="row g-2 align-items-center">
            <div class="col-md-5 d-flex gap-1 align-items-center">
                <input type="date" name="fromDate" value="@fromDate" class="form-control form-control-sm" placeholder="From" />
                <span class="small text-muted">-</span>
                <input type="date" name="toDate" value="@toDate" class="form-control form-control-sm" placeholder="To" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-secondary btn-sm flex-grow-1">Filter</button>
                <a asp-action="UserActivityReport" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent fw-semibold">
        Active Team Members Activity Breakdown
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>User Name</th>
                        <th>Login Count</th>
                        <th>Creates</th>
                        <th>Updates</th>
                        <th>Deletes</th>
                        <th>Total Actions Logged</th>
                        <th>Last Active</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@u.UserName</td>
                            <td><span class="badge bg-primary-subtle text-primary">@u.LoginCount</span></td>
                            <td><span class="badge bg-success-subtle text-success">@u.CreateCount</span></td>
                            <td><span class="badge bg-info-subtle text-info">@u.UpdateCount</span></td>
                            <td><span class="badge bg-danger-subtle text-danger">@u.DeleteCount</span></td>
                            <td class="fw-bold">@u.TotalActions</td>
                            <td class="small text-muted">@(u.LastActive?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
