@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunity Report";
    var stage = ViewData["Stage"]?.ToString();
    var status = ViewData["Status"]?.ToString();
    var fromDate = ViewData["FromDate"]?.ToString();
    var toDate = ViewData["ToDate"]?.ToString();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-0">Opportunity Deals Report</h2>
        <p class="text-muted small mb-0">Full opportunity records, stages, amounts, win probabilities, and close forecast</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="OpportunityReport" asp-route-stage="@stage" asp-route-status="@status" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-export="csv" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="bi bi-file-earmark-arrow-down me-1"></i> Export to CSV
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Hub
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="OpportunityReport" class="row g-2 align-items-center">
            <div class="col-md-3">
                <select name="stage" class="form-select form-select-sm">
                    <option value="">All Stages</option>
                    @foreach (var stg in AcxiomCRM.Models.OpportunityStages.All)
                    {
                        <option value="@stg" selected="@(stage == stg)">@stg</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Open" selected="@(status == "Open")">Open</option>
                    <option value="Won" selected="@(status == "Won")">Won</option>
                    <option value="Lost" selected="@(status == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-1 align-items-center">
                <input type="date" name="fromDate" value="@fromDate" class="form-control form-control-sm" placeholder="From" />
                <span class="small text-muted">-</span>
                <input type="date" name="toDate" value="@toDate" class="form-control form-control-sm" placeholder="To" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary btn-sm flex-grow-1">Filter</button>
                <a asp-action="OpportunityReport" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Total Deals: @Model.Count() | Gross Value: $@Model.Sum(o => o.Amount).ToString("N2") | Weighted: $@Model.Sum(o => o.WeightedPipeline).ToString("N2")</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Deal Name</th>
                        <th>Account / Customer</th>
                        <th>Stage</th>
                        <th>Amount ($)</th>
                        <th>Prob (%)</th>
                        <th>Weighted Value ($)</th>
                        <th>Expected Close</th>
                        <th>Status</th>
                        <th>Owner</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@o.OpportunityName</td>
                            <td>@(o.Customer?.CustomerName ?? o.Lead?.LeadName ?? "-")</td>
                            <td><span class="badge bg-primary-subtle text-primary">@o.Stage</span></td>
                            <td class="fw-bold">$@o.Amount.ToString("N2")</td>
                            <td>@o.Probability%</td>
                            <td class="fw-semibold text-success">$@o.WeightedPipeline.ToString("N2")</td>
                            <td class="small">@o.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                            <td><span class="badge @(o.Status == "Won" ? "bg-success" : (o.Status == "Lost" ? "bg-danger" : "bg-warning"))">@o.Status</span></td>
                            <td class="small text-muted">@(o.AssignedUser?.FullName ?? "Unassigned")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
