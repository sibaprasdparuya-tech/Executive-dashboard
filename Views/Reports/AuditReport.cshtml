@model IEnumerable<AcxiomCRM.Models.AuditLog>
@{
    ViewData["Title"] = "Security & Business Audit Report";
    var userId = ViewData["UserId"]?.ToString();
    var entityName = ViewData["EntityName"]?.ToString();
    var actionName = ViewData["ActionName"]?.ToString();
    var fromDate = ViewData["FromDate"]?.ToString();
    var toDate = ViewData["ToDate"]?.ToString();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-0">Compliance Audit Report</h2>
        <p class="text-muted small mb-0">Official compliance export of security events, mutations, logins, and access events</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="AuditReport" asp-route-userId="@userId" asp-route-entityName="@entityName" asp-route-action="@actionName" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-export="csv" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="bi bi-file-earmark-arrow-down me-1"></i> Export to CSV
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Hub
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="AuditReport" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="entityName" value="@entityName" class="form-control form-control-sm" placeholder="Module (e.g. Auth, Customer)" />
            </div>
            <div class="col-md-3">
                <input type="text" name="action" value="@actionName" class="form-control form-control-sm" placeholder="Action (e.g. Login, Create)" />
            </div>
            <div class="col-md-4 d-flex gap-1 align-items-center">
                <input type="date" name="fromDate" value="@fromDate" class="form-control form-control-sm" placeholder="From" />
                <span class="small text-muted">-</span>
                <input type="date" name="toDate" value="@toDate" class="form-control form-control-sm" placeholder="To" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary btn-sm flex-grow-1">Filter</button>
                <a asp-action="AuditReport" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Total Audit Entries: @Model.Count()</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 font-monospace small">
                <thead>
                    <tr>
                        <th>Timestamp (UTC)</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Module</th>
                        <th>Record ID</th>
                        <th>Result</th>
                        <th>Details</th>
                        <th>IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@a.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="fw-semibold">@(a.UserName ?? "System")</td>
                            <td><span class="badge bg-secondary-subtle text-secondary border">@a.Action</span></td>
                            <td>@a.EntityName</td>
                            <td>@(a.RecordId ?? "-")</td>
                            <td><span class="@(a.Result == "Success" ? "text-success" : "text-danger fw-bold")">@a.Result</span></td>
                            <td class="text-truncate" style="max-width: 300px;" title="@a.Details">@(a.Details ?? "-")</td>
                            <td>@(a.IpAddress ?? "Local")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
