@model IEnumerable<AcxiomCRM.Models.FollowUp>
@{
    ViewData["Title"] = "Follow-Up Report";
    var status = ViewData["Status"]?.ToString();
    var fromDate = ViewData["FromDate"]?.ToString();
    var toDate = ViewData["ToDate"]?.ToString();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-0">Follow-Up & Outreach Report</h2>
        <p class="text-muted small mb-0">Review completed tasks, upcoming appointments, and overdue follow-ups</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="FollowUpReport" asp-route-status="@status" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-export="csv" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="bi bi-file-earmark-arrow-down me-1"></i> Export to CSV
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Hub
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="FollowUpReport" class="row g-2 align-items-center">
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var st in AcxiomCRM.Models.FollowUpStatuses.All)
                    {
                        <option value="@st" selected="@(status == st)">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex gap-1 align-items-center">
                <input type="date" name="fromDate" value="@fromDate" class="form-control form-control-sm" placeholder="From" />
                <span class="small text-muted">-</span>
                <input type="date" name="toDate" value="@toDate" class="form-control form-control-sm" placeholder="To" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-secondary btn-sm flex-grow-1">Filter</button>
                <a asp-action="FollowUpReport" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Total Follow-Ups: @Model.Count()</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Subject</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Related Entity</th>
                        <th>Assigned User</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model)
                    {
                        <tr>
                            <td class="@(f.IsOverdue ? "text-danger fw-bold" : "")">@f.FollowUpDate.ToString("yyyy-MM-dd")</td>
                            <td class="fw-semibold">@f.Subject</td>
                            <td><span class="badge bg-secondary-subtle text-secondary">@f.FollowUpType</span></td>
                            <td><span class="badge @(f.Status == "Completed" ? "bg-success" : (f.IsOverdue ? "bg-danger" : "bg-warning"))">@f.Status</span></td>
                            <td>@(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? "-")</td>
                            <td class="small text-muted">@(f.AssignedUser?.FullName ?? "Unassigned")</td>
                            <td class="small text-muted text-truncate" style="max-width: 200px;">@(f.Remarks ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
