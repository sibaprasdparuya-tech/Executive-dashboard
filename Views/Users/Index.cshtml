@model IEnumerable<AcxiomCRM.ViewModels.UserListItemViewModel>
@{
    ViewData["Title"] = "User & Role Administration";
    var searchTerm = ViewData["SearchTerm"]?.ToString();
    var roleFilter = ViewData["RoleFilter"]?.ToString();
    var roles = ViewBag.Roles as string[] ?? Array.Empty<string>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-0">User & Role Administration</h2>
        <p class="text-muted small mb-0">System access control, role assignment, lockout security and credential management</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Create New User
        </a>
    </div>
</div>

<!-- Filters (Section 17.10) -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-6">
                <input type="text" name="searchTerm" value="@searchTerm" class="form-control" placeholder="Search by name or email..." />
            </div>
            <div class="col-md-4">
                <select name="roleFilter" class="form-select">
                    <option value="">All Roles</option>
                    @foreach (var r in roles)
                    {
                        <option value="@r" selected="@(roleFilter == r)">@r</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Users Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>User Name</th>
                        <th>Email</th>
                        <th>Assigned Role</th>
                        <th>Account Status</th>
                        <th>Security / Lockout</th>
                        <th>Failed Logins</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="avatar-circle">@(u.FullName.Length > 0 ? u.FullName.Substring(0, 1).ToUpper() : "U")</span>
                                    <span>@u.FullName</span>
                                </div>
                            </td>
                            <td>@u.Email</td>
                            <td>
                                @if (u.Role == "Admin")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-shield-fill me-1"></i>Admin</span>
                                }
                                else if (u.Role == "Manager")
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-person-workspace me-1"></i>Manager</span>
                                }
                                else
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle"><i class="bi bi-person me-1"></i>SalesExecutive</span>
                                }
                            </td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">Inactive</span>
                                }
                            </td>
                            <td>
                                @if (u.IsLockedOut)
                                {
                                    <span class="badge bg-danger text-white"><i class="bi bi-lock-fill me-1"></i>LOCKED</span>
                                    <div class="small text-danger">Until @u.LockoutEnd?.ToString("HH:mm:ss UTC")</div>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border"><i class="bi bi-unlock me-1"></i>Unlocked</span>
                                }
                            </td>
                            <td>
                                @if (u.AccessFailedCount > 0)
                                {
                                    <span class="badge bg-warning text-dark">@u.AccessFailedCount / 5</span>
                                }
                                else
                                {
                                    <span class="text-muted small">0</span>
                                }
                            </td>
                            <td class="small text-muted">@u.CreatedDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline-primary" title="Edit Profile & Role">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-outline-warning" title="Reset Password">
                                        <i class="bi bi-key"></i>
                                    </a>

                                    @if (u.IsLockedOut)
                                    {
                                        <!-- Controlled Unlock Process (Section 6.3) -->
                                        <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-warning" title="Unlock Account">
                                                <i class="bi bi-unlock-fill"></i> Unlock
                                            </button>
                                        </form>
                                    }

                                    <form asp-action="ToggleStatus" asp-route-id="@u.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn @(u.IsActive ? "btn-outline-secondary" : "btn-outline-success")" title="@(u.IsActive ? "Deactivate" : "Activate")">
                                            <i class="bi @(u.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
