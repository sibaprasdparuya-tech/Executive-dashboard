@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = "Create Opportunity";
    var customers = ViewBag.Customers as SelectList;
    var leads = ViewBag.Leads as SelectList;
    var users = ViewBag.Users as SelectList;
    var stages = ViewBag.Stages as SelectList;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-0">Create Sales Opportunity</h3>
                <p class="text-muted small mb-0">Register deal in pipeline with value and win probability</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="opportunityForm" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="OpportunityName" class="form-label fw-semibold small">Opportunity / Deal Name <span class="text-danger">*</span></label>
                        <input asp-for="OpportunityName" class="form-control" placeholder="e.g. Enterprise Cloud Deployment Phase 2" required maxlength="150" />
                        <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold small">Associated Customer</label>
                            <select asp-for="CustomerId" asp-items="customers" class="form-select">
                                <option value="">-- Select Customer (Optional) --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label fw-semibold small">Originating Lead</label>
                            <select asp-for="LeadId" asp-items="leads" class="form-select">
                                <option value="">-- Select Lead (Optional) --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Amount" class="form-label fw-semibold small">Amount ($) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Amount" id="oppAmount" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" required />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Probability" class="form-label fw-semibold small">Win Probability (0-100%) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="Probability" id="oppProbability" type="number" min="0" max="100" class="form-control" placeholder="20" required />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-muted">Weighted Return (Calculated)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="text" id="weightedReturnPreview" class="form-control bg-light fw-bold text-success" readonly value="0.00" />
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Stage" class="form-label fw-semibold small">Pipeline Stage <span class="text-danger">*</span></label>
                            <select asp-for="Stage" asp-items="stages" class="form-select" id="oppStage">
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ExpectedCloseDate" class="form-label fw-semibold small">Expected Close Date <span class="text-danger">*</span></label>
                            <input asp-for="ExpectedCloseDate" id="oppCloseDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold small">Status</label>
                            <select asp-for="Status" class="form-select" id="oppStatus">
                                <option value="Open">Open</option>
                                <option value="Won">Won</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <div class="mb-3">
                            <label asp-for="AssignedTo" class="form-label fw-semibold small">Opportunity Owner</label>
                            <select asp-for="AssignedTo" asp-items="users" class="form-select">
                            </select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>
                    }

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold small">Deal Notes & Action Items</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Key decision makers, competition, hurdles, next steps..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i> Save Opportunity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            function updateWeighted() {
                var amt = parseFloat($('#oppAmount').val()) || 0;
                var prob = parseFloat($('#oppProbability').val()) || 0;
                var weighted = (amt * prob) / 100.0;
                $('#weightedReturnPreview').val(weighted.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            }

            $('#oppAmount, #oppProbability').on('input', updateWeighted);
            updateWeighted();

            // Client-side date check
            $('#opportunityForm').on('submit', function (e) {
                var closeDate = new Date($('#oppCloseDate').val());
                var today = new Date();
                today.setHours(0,0,0,0);
                
                var amount = parseFloat($('#oppAmount').val());
                var prob = parseFloat($('#oppProbability').val());

                if (isNaN(amount) || amount <= 0) {
                    alert('Opportunity Amount must be greater than 0.');
                    e.preventDefault();
                    return false;
                }

                if (isNaN(prob) || prob < 0 || prob > 100) {
                    alert('Probability must be between 0 and 100.');
                    e.preventDefault();
                    return false;
                }

                var status = $('#oppStatus').val();
                if (status === 'Open' && closeDate < today) {
                    alert('Expected Close Date cannot be in the past.');
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}
