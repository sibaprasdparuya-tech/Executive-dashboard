@model IEnumerable<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Lead Management";
    var currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var totalCount = (int)(ViewData["TotalCount"] ?? 0);
    var searchTerm = ViewData["SearchTerm"]?.ToString();
    var statusFilter = ViewData["Status"]?.ToString();
    var assignedToFilter = ViewData["AssignedTo"]?.ToString();
    var users = ViewBag.Users as IEnumerable<AcxiomCRM.Models.ApplicationUser> ?? Enumerable.Empty<AcxiomCRM.Models.ApplicationUser>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-0">Lead Pipeline</h2>
        <p class="text-muted small mb-0">Capture, qualify, and convert sales prospects</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus me-1"></i> Add New Lead
        </a>
    </div>
</div>

<!-- Search & Filters (Section 17.13) -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@searchTerm" class="form-control" placeholder="Search by name, company, email..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    @foreach (var st in AcxiomCRM.Models.LeadStatuses.All)
                    {
                        <option value="@st" selected="@(statusFilter == st)">@st</option>
                    }
                </select>
            </div>
            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <div class="col-md-3">
                    <select name="assignedTo" class="form-select">
                        <option value="">All Assigned Users</option>
                        @foreach (var u in users)
                        {
                            <option value="@u.Id" selected="@(assignedToFilter == u.Id)">@u.FullName</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Leads Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Showing @Model.Count() of @totalCount Leads</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Lead Name</th>
                            <th>Company</th>
                            <th>Contact</th>
                            <th>Source</th>
                            <th>Priority</th>
                            <th>Est. Value</th>
                            <th>Status</th>
                            <th>Owner</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark font-monospace border">@l.LeadCode</span>
                                </td>
                                <td class="fw-semibold">
                                    <a asp-action="Details" asp-route-id="@l.LeadId" class="text-decoration-none text-dark">
                                        @l.LeadName
                                    </a>
                                </td>
                                <td>@(l.CompanyName ?? "-")</td>
                                <td>
                                    <div class="small text-muted"><i class="bi bi-envelope me-1"></i>@l.Email</div>
                                    <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@l.Phone</div>
                                </td>
                                <td><span class="badge bg-light text-secondary border">@l.Source</span></td>
                                <td>
                                    <span class="badge @(l.Priority == "High" ? "bg-danger-subtle text-danger" : (l.Priority == "Medium" ? "bg-warning-subtle text-warning" : "bg-info-subtle text-info"))">
                                        @l.Priority
                                    </span>
                                </td>
                                <td class="fw-bold text-dark">$@l.ExpectedValue.ToString("N0")</td>
                                <td>
                                    @if (l.Status == "Converted")
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-check-all me-1"></i>Converted</span>
                                    }
                                    else if (l.Status == "Qualified")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Qualified</span>
                                    }
                                    else if (l.Status == "Lost")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Lost</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">@l.Status</span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @(l.AssignedUser?.FullName ?? l.AssignedUser?.UserName ?? "Unassigned")
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@l.LeadId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@l.LeadId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@l.LeadId" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Delete Modal -->
                                    <div class="modal fade text-start" id="deleteModal-@l.LeadId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Lead</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Are you sure you want to delete lead <strong>@l.LeadName</strong> (@l.LeadCode)?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@l.LeadId" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                    <span class="small text-muted">Page @currentPage of @totalPages</span>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">Previous</a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Next</a>
                        </li>
                    </ul>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-person-x fs-1 text-muted"></i>
                <h5 class="mt-3 text-muted">No leads found</h5>
                <a asp-action="Create" class="btn btn-primary btn-sm">Capture Lead</a>
            </div>
        }
    </div>
</div>
