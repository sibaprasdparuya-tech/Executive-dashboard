@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = $"Lead: {Model.LeadName}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0">@Model.LeadName</h2>
            <span class="badge bg-light text-dark font-monospace border">@Model.LeadCode</span>
            <span class="badge @(Model.Status == "Converted" ? "bg-primary-subtle text-primary" : (Model.Status == "Qualified" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")) border">@Model.Status</span>
        </div>
        <p class="text-muted small mb-0">Lead Profile, Conversion Status & Activities</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>

        @if (Model.Status != "Converted")
        {
            <!-- Lead Conversion Action Button (Section 4.5 & 8) -->
            <button type="button" class="btn btn-success btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#convertLeadModal">
                <i class="bi bi-arrow-repeat me-1"></i> Convert Lead
            </button>
        }
        else
        {
            @if (Model.ConvertedCustomerId.HasValue)
            {
                <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.ConvertedCustomerId.Value" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-person-check me-1"></i> View Converted Customer
                </a>
            }
        }

        <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> + Follow-Up
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Lead Profile Card -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent fw-semibold">
                <i class="bi bi-info-circle me-1 text-primary"></i> Lead Overview
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="text-muted small">Company</div>
                    <div class="fw-semibold">@(Model.CompanyName ?? "N/A")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-6">
                        <div class="text-muted small">Email Address</div>
                        <div><a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a></div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">Phone Number</div>
                        <div class="fw-semibold">@Model.Phone</div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-6">
                        <div class="text-muted small">Lead Source</div>
                        <div><span class="badge bg-light text-dark border">@Model.Source</span></div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">Priority</div>
                        <div><span class="badge bg-warning-subtle text-warning">@Model.Priority</span></div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small">Expected Deal Value</div>
                    <h4 class="fw-bold text-success mb-0">$@Model.ExpectedValue.ToString("N2")</h4>
                </div>
                <div class="mb-3">
                    <div class="text-muted small">Assigned Sales Executive</div>
                    <div class="fw-semibold">@(Model.AssignedUser?.FullName ?? Model.AssignedUser?.UserName ?? "Unassigned")</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small">Created Date</div>
                    <div class="small">@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm UTC")</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="mb-2">
                        <div class="text-muted small">Discovery Notes</div>
                        <div class="p-2 bg-light rounded small">@Model.Notes</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right: Related Follow-ups & Activities -->
    <div class="col-lg-7">
        <!-- Follow-Ups for Lead -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <span class="fw-semibold"><i class="bi bi-calendar-event me-1 text-primary"></i> Follow-Up Activities (@Model.FollowUps.Count)</span>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-primary btn-sm py-0">+ Follow-Up</a>
            </div>
            <div class="card-body p-0">
                @if (Model.FollowUps.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Subject</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in Model.FollowUps)
                                {
                                    <tr>
                                        <td class="small">@f.FollowUpDate.ToString("yyyy-MM-dd")</td>
                                        <td class="fw-semibold">@f.Subject</td>
                                        <td><span class="badge bg-secondary-subtle text-secondary">@f.FollowUpType</span></td>
                                        <td><span class="badge @(f.Status == "Completed" ? "bg-success" : "bg-warning")">@f.Status</span></td>
                                        <td><a asp-controller="FollowUps" asp-action="Details" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-link p-0">View</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-3 text-center text-muted small">No scheduled follow-ups for this lead.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Lead Conversion Modal (Section 4.5, 8 & 17.2) -->
<div class="modal fade" id="convertLeadModal" tabindex="-1" aria-labelledby="convertLeadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Convert" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="LeadId" value="@Model.LeadId" />

                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="convertLeadModalLabel">
                        <i class="bi bi-arrow-repeat text-success me-2"></i>Convert Lead to Customer & Opportunity
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">
                        Converting this lead will create a new Customer master record for <strong>@Model.LeadName</strong> 
                        and change the lead status to <strong>Converted</strong>.
                    </p>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="createOppCheck" name="CreateOpportunity" value="true" checked>
                        <label class="form-check-label fw-semibold" for="createOppCheck">Also create a Sales Opportunity</label>
                    </div>

                    <div id="oppDetails">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Opportunity Name</label>
                            <input type="text" name="OpportunityName" class="form-control" value="@Model.LeadName - New Contract" />
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Opportunity Amount ($)</label>
                                <input type="number" step="0.01" name="OpportunityAmount" class="form-control" value="@Model.ExpectedValue" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Expected Close Date</label>
                                <input type="date" name="ExpectedCloseDate" class="form-control" value="@DateTime.Today.AddDays(30).ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Conversion Notes</label>
                        <textarea name="Notes" class="form-control form-control-sm" rows="2" placeholder="e.g. Qualified after product demo. Ready for formal proposal."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-sm px-3">
                        <i class="bi bi-check-circle me-1"></i> Complete Conversion
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
